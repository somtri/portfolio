# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.tools/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# keep the template tracked
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# session/working files (local only)
/handoff.md
/HANDOFF-*.md
/STATE.md
/.claude/
/.memsearch/

# impeccable: the detector config is shared, its cache is not
/.impeccable/hook.cache.json

# NOTE: lib/assistant/vectors.json is deliberately NOT ignored. It is generated
# by `pnpm embed`, but the runtime reads it from disk on Vercel, so ignoring it
# meant retrieval silently degraded to the full-context fallback in production.
# Commit it together with vectors.meta.json, whose hash a test checks for drift.
