# Copy values into Vercel env vars (server-side only). Never commit real keys.

# Chat provider — OpenAI-compatible /chat/completions endpoint.
ASSISTANT_BASE_URL=https://api.groq.com/openai/v1
ASSISTANT_MODEL=llama-3.3-70b-versatile
ASSISTANT_API_KEY=

# Alternate: NVIDIA build.nvidia.com — dev/eval only, not for production
# (NVIDIA API Trial ToS §1.4).
# ASSISTANT_BASE_URL=https://integrate.api.nvidia.com/v1

# Alternate: Gemini (OpenAI-compatible endpoint).
# ASSISTANT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Embeddings — Cloudflare Workers AI. Absent → assistant falls back to
# full-context (no retrieval); run `pnpm embed` after setting these to
# activate retrieval.
EMBEDDINGS_ACCOUNT_ID=
EMBEDDINGS_API_TOKEN=
EMBEDDINGS_MODEL=@cf/baai/bge-small-en-v1.5

# Optional tuning: minimum cosine similarity for a retrieved section to
# count as context (default 0.4).
# ASSISTANT_MIN_SIMILARITY=0.4
